# Copy to .env for local development.
# Point boto3 at LocalStack; delete AWS_ENDPOINT_URL to target real AWS instead.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1

# LocalStack accepts any credentials; real AWS uses your configured profile.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

PLANTWATCH_RAW_BUCKET=plantwatch-raw
PLANTWATCH_RAW_PREFIX=sensors
